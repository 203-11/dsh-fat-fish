{
  "name": "dsh-fat-fish",
  "version": "1.0.0",
  "description": "A draggable fish-maid desk pet for DSH Web with hydration and walk reminders, daily logs, custom avatars, free resizing, meme-flavored thoughts, and an original Manbo-style synth chime.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "desk-pet",
    "reminder",
    "ui",
    "fun"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.webp"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.webp",
    "assets/default-avatar.webp"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
